# Local plaintext Kafka only. Export these values before running Python commands.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=configstream-generator
KAFKA_DELIVERY_TIMEOUT_MS=10000
KAFKA_FLUSH_TIMEOUT_SECONDS=15
KAFKA_ENQUEUE_TIMEOUT_SECONDS=5
# Spark local mode; install with make spark-setup and provide Java 21.
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=1g
SPARK_APP_NAME=ConfigStreamStreaming
SPARK_CHECKPOINT_DIR=.cache/spark-checkpoints/config-snapshots-v8
SPARK_RUNTIME_DIR=.cache/spark
SPARK_STARTING_OFFSETS=latest
SPARK_TRIGGER_SECONDS=2
SPARK_MAX_OFFSETS_PER_TRIGGER=10000
SPARK_CONSOLE_ROWS=20
SPARK_WATERMARK_DELAY=10 minutes
SPARK_STATE_TIMEOUT=30 minutes
SPARK_MAX_VERSIONS_PER_ASSET=32
CONFIGSTREAM_RULES_FILE=rules/default.yaml
# Optional local MinIO data lake; generate private values with make lake-env.
CONFIGSTREAM_LAKE_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
CONFIGSTREAM_LAKE_BUCKET=config-lake
CONFIGSTREAM_LAKE_PREFIX=
CONFIGSTREAM_LAKE_MAX_RECORDS_PER_FILE=100000
CONFIGSTREAM_SEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
CONFIGSTREAM_SEARCH_INDEX_PREFIX=configstream
CONFIGSTREAM_SEARCH_BULK_SIZE=1000
CONFIGSTREAM_SEARCH_TIMEOUT_SECONDS=30
CONFIGSTREAM_SEARCH_DIFF_DETAILS=false
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
CONFIGSTREAM_API_HOST=127.0.0.1
CONFIGSTREAM_API_PORT=8000
CONFIGSTREAM_API_LOG_LEVEL=info
CONFIGSTREAM_API_DOCS=true
# For lake mode, omit SPARK_CHECKPOINT_DIR or use a fresh v7 checkpoint.
# Makefile already defaults to these project-local tool directories.
UV_CACHE_DIR=.cache/uv
UV_PYTHON_INSTALL_DIR=.tools/python
# Future service configuration belongs in environment variables, never in source.
# Do not commit .env or real credentials. This file is not loaded automatically.
